      <column caption='Booking Date' datatype='date' name='[Booking_Date]' role='dimension' type='ordinal' />
      <column caption='Booking ID' datatype='integer' name='[Booking_ID]' role='dimension' type='ordinal' />
      <column caption='Booking Status' datatype='string' name='[Booking_Status]' role='dimension' type='nominal' />
      <column caption='Net Revenue' datatype='integer' default-format='c&quot;$&quot;#,##0,,.00M;(&quot;$&quot;#,##0,,.00M)' name='[Calculation_1453330208227328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total_Trip_Cost]) - SUM([Discount_Amount])' />
      </column>
      <column caption='Cancellation Rate' datatype='real' default-format='p0.00%' name='[Calculation_1453330208542721]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [Cancellation_Status] = &apos;Cancelled&apos; THEN [Booking_ID] END) / COUNT([Booking_ID])' />
      </column>
      <column caption='Average Lead Time (Days)' datatype='real' name='[Calculation_1453330208673794]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(DATEDIFF(&apos;day&apos;, [Booking_Date], [Travel_Date]))' />
      </column>
      <column caption='Lead Time Bracket' datatype='string' name='[Calculation_1548438584807424]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;, [Booking_Date], [Travel_Date]) &lt;= 7 THEN &quot;0-7 Days&quot;&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [Booking_Date], [Travel_Date]) &lt;= 14 THEN &quot;8-14 Days&quot;&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [Booking_Date], [Travel_Date]) &lt;= 30 THEN &quot;15-30 Days&quot;&#13;&#10;ELSE &quot;30+ Days&quot;&#13;&#10;END' />
      </column>
      <column caption='Trip Cost Tier' datatype='string' name='[Calculation_1548438591492097]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Total_Trip_Cost] &lt;= 300000 THEN &quot;Budget (&lt;$300K)&quot;&#13;&#10;ELSEIF [Total_Trip_Cost] &lt;= 700000 THEN &quot;Mid-Tier ($300K-$700K)&quot;&#13;&#10;ELSE &quot;Luxury ($700K+)&quot;&#13;&#10;END' />
      </column>
      <column caption='Total Bookings' datatype='integer' name='[Calculation_3004741472952320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Booking_ID])' />
      </column>
      <column caption='Average Ratings' datatype='real' name='[Calculation_3004741475868674]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Hotel_Rating])' />
      </column>
      <column caption='KPI_Avg_Lead_Time' datatype='integer' name='[Calculation_3004741499060228]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Booking_Date], [Travel_Date])' />
      </column>
      <column caption='Repeat Customer %' datatype='real' default-format='p0.00%' name='[Calculation_3004741502410757]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Booking_Status] != &apos;Cancelled&apos; THEN [Customer_ID] END) / COUNTD([Customer_ID])' />
      </column>
      <column caption='Time Lead Groups' datatype='integer' name='[Calculation_3004741518462982]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Booking_Date], [Travel_Date])' />
      </column>
