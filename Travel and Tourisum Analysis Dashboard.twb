    <worksheet name='Chart_Rating_vs_TripCost'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Times New Roman'>CUSTOMER RATING VS. TOTAL TRIP COST</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Travel And Tourism (1)' name='federated.03ev4bz1dh5vj71g43w0y11zg9yx' />
          </datasources>
          <datasource-dependencies datasource='federated.03ev4bz1dh5vj71g43w0y11zg9yx'>
            <column caption='Trip Cost Tier' datatype='string' name='[Calculation_1548438591492097]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Total_Trip_Cost] &lt;= 300000 THEN &quot;Budget (&lt;$300K)&quot;&#13;&#10;ELSEIF [Total_Trip_Cost] &lt;= 700000 THEN &quot;Mid-Tier ($300K-$700K)&quot;&#13;&#10;ELSE &quot;Luxury ($700K+)&quot;&#13;&#10;END' />
            </column>
            <column caption='Cancellation Status' datatype='string' name='[Cancellation_Status]' role='dimension' type='nominal' />
            <column caption='Customer Rating' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Customer_Rating]' role='measure' type='quantitative' />
            <column caption='Destination City' datatype='string' name='[Destination_City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Meal Plan' datatype='string' name='[Meal_Plan]' role='dimension' type='nominal' />
            <column caption='Total Trip Cost' datatype='integer' default-format='c&quot;$&quot;#,##0,,.0M;(&quot;$&quot;#,##0,,.0M)' name='[Total_Trip_Cost]' role='measure' type='quantitative' />
