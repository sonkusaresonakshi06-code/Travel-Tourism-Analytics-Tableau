    <worksheet name='Chart_LeadTime_vs_Cancellation'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Times New Roman' fontsize='14'>CANCELLATION RISK BY BOOKING LEAD TIME</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Travel And Tourism (1)' name='federated.03ev4bz1dh5vj71g43w0y11zg9yx' />
          </datasources>
          <datasource-dependencies datasource='federated.03ev4bz1dh5vj71g43w0y11zg9yx'>
            <column caption='Booking Date' datatype='date' name='[Booking_Date]' role='dimension' type='ordinal' />
            <column caption='Booking ID' datatype='integer' name='[Booking_ID]' role='dimension' type='ordinal' />
            <column caption='Cancellation Rate' datatype='real' default-format='p0.00%' name='[Calculation_1453330208542721]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [Cancellation_Status] = &apos;Cancelled&apos; THEN [Booking_ID] END) / COUNT([Booking_ID])' />
            </column>
            <column caption='Lead Time Bracket' datatype='string' name='[Calculation_1548438584807424]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;, [Booking_Date], [Travel_Date]) &lt;= 7 THEN &quot;0-7 Days&quot;&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [Booking_Date], [Travel_Date]) &lt;= 14 THEN &quot;8-14 Days&quot;&#13;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [Booking_Date], [Travel_Date]) &lt;= 30 THEN &quot;15-30 Days&quot;&#13;&#10;ELSE &quot;30+ Days&quot;&#13;&#10;END' />
            </column>
            <column caption='Trip Cost Tier' datatype='string' name='[Calculation_1548438591492097]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Total_Trip_Cost] &lt;= 300000 THEN &quot;Budget (&lt;$300K)&quot;&#13;&#10;ELSEIF [Total_Trip_Cost] &lt;= 700000 THEN &quot;Mid-Tier ($300K-$700K)&quot;&#13;&#10;ELSE &quot;Luxury ($700K+)&quot;&#13;&#10;END' />
            </column>
            <column caption='Cancellation Status' datatype='string' name='[Cancellation_Status]' role='dimension' type='nominal' />
            <column caption='Destination City' datatype='string' name='[Destination_City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Meal Plan' datatype='string' name='[Meal_Plan]' role='dimension' type='nominal' />
            <column caption='Total Trip Cost' datatype='integer' default-format='c&quot;$&quot;#,##0,,.0M;(&quot;$&quot;#,##0,,.0M)' name='[Total_Trip_Cost]' role='measure' type='quantitative' />
            <column caption='Travel Date' datatype='date' name='[Travel_Date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1548438584807424]' derivation='None' name='[none:Calculation_1548438584807424:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1548438591492097]' derivation='None' name='[none:Calculation_1548438591492097:nk]' pivot='key' type='nominal' />
            <column-instance column='[Cancellation_Status]' derivation='None' name='[none:Cancellation_Status:nk]' pivot='key' type='nominal' />
            <column-instance column='[Destination_City]' derivation='None' name='[none:Destination_City:nk]' pivot='key' type='nominal' />
            <column-instance column='[Meal_Plan]' derivation='None' name='[none:Meal_Plan:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1453330208542721]' derivation='User' name='[usr:Calculation_1453330208542721:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <shelf-sorts>
            <shelf-sort-v2 dimension-to-sort='[federated.03ev4bz1dh5vj71g43w0y11zg9yx].[none:Calculation_1548438584807424:nk]' direction='DESC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.03ev4bz1dh5vj71g43w0y11zg9yx].[usr:Calculation_1453330208542721:qk]' shelf='columns' />
          </shelf-sorts>
          <slices>
            <column>[federated.03ev4bz1dh5vj71g43w0y11zg9yx].[none:Calculation_1548438591492097:nk]</column>
            <column>[federated.03ev4bz1dh5vj71g43w0y11zg9yx].[none:Meal_Plan:nk]</column>
            <column>[federated.03ev4bz1dh5vj71g43w0y11zg9yx].[none:Destination_City:nk]</column>
            <column>[federated.03ev4bz1dh5vj71g43w0y11zg9yx].[none:Cancellation_Status:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='display' class='0' field='[federated.03ev4bz1dh5vj71g43w0y11zg9yx].[usr:Calculation_1453330208542721:qk]' scope='rows' value='false' />
          </style-rule>
