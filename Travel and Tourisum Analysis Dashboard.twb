            <column caption='Discount Amount' datatype='integer' default-format='c&quot;$&quot;#,##0,,.00M;(&quot;$&quot;#,##0,,.00M)' name='[Discount_Amount]' role='measure' type='quantitative' />
            <column caption='Meal Plan' datatype='string' name='[Meal_Plan]' role='dimension' type='nominal' />
            <column caption='Payment Method' datatype='string' name='[Payment_Method]' role='dimension' type='nominal' />
            <column caption='Total Trip Cost' datatype='integer' default-format='c&quot;$&quot;#,##0,,.0M;(&quot;$&quot;#,##0,,.0M)' name='[Total_Trip_Cost]' role='measure' type='quantitative' />
